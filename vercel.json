{
  "redirects": [
    {
      "source": "/",
      "has": [
        { "type": "query", "key": "clip" }
      ],
      "missing": [
        { "type": "query", "key": "go" }
      ],
      "destination": "/api/og",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}